		--color-secondary-400: 168 35 27;
		--color-secondary-500: 138 34 25;
		--color-secondary-600: 110 42 36;
		--color-secondary-700: 78 43 39;
		--color-secondary-800: 56 33 30;

		--color-space-50: 235 219 178;
		--color-space-100: 213 196 161;
		--color-space-200: 189 174 147;
		--color-space-300: 168 153 132;
		--color-space-400: 146 131 116;
		--color-space-500: 124 111 100;
		--color-space-600: 102 92 84;
		--color-space-700: 80 73 69;
		--color-space-800: 60 56 54;
		--color-space-900: 40 40 40;
		--color-space-950: 29 32 33;

		--color-gray-50: 251 241 199;
		--color-gray-100: 235 219 178;
		--color-gray-200: 213 196 161;
		--color-gray-300: 189 174 147;
		--color-gray-400: 168 153 132;
		--color-gray-500: 146 131 116;
