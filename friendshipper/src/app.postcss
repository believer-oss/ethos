/* Write your global styles here, in PostCSS syntax */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* Theme palettes as RGB channels so Tailwind opacity modifiers keep working. See tailwind.config.cjs. */
@layer base {
	:root {
		--color-primary-100: 254 249 236;
		--color-primary-200: 252 238 201;
		--color-primary-300: 249 218 142;
		--color-primary-400: 246 197 92;
		--color-primary-500: 243 170 44;
		--color-primary-600: 236 138 20;
		--color-primary-700: 209 102 14;
		--color-primary-800: 174 71 15;
		--color-primary-900: 141 55 19;
		--color-primary-950: 116 46 19;

		--color-secondary-50: 233 184 185;
		--color-secondary-100: 221 143 147;
		--color-secondary-200: 204 103 109;
		--color-secondary-300: 182 72 85;
		--color-secondary-400: 158 58 72;
		--color-secondary-500: 128 49 63;
		--color-secondary-600: 110 45 58;
		--color-secondary-700: 85 33 43;
		--color-secondary-800: 60 21 28;

		--color-space-50: 244 247 247;
		--color-space-100: 228 233 233;
		--color-space-200: 203 213 214;
		--color-space-300: 167 183 185;
		--color-space-400: 123 146 149;
		--color-space-500: 96 119 122;
		--color-space-600: 83 99 103;
		--color-space-700: 71 84 87;
		--color-space-800: 63 72 75;
		--color-space-900: 47 53 55;
		--color-space-950: 34 40 42;

		--color-gray-50: 249 250 251;
		--color-gray-100: 243 244 246;
		--color-gray-200: 229 231 235;
		--color-gray-300: 209 213 219;
		--color-gray-400: 156 163 175;
		--color-gray-500: 107 114 128;
		--color-gray-600: 75 85 99;
		--color-gray-700: 55 65 81;
		--color-gray-800: 31 41 55;
		--color-gray-900: 17 24 39;
		--color-gray-950: 3 7 18;

		--color-white: 255 255 255;
	}

	html.gruvbox {
		--color-primary-100: 251 241 199;
		--color-primary-200: 249 226 163;
