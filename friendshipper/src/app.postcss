		--color-space-900: 13 26 13;
		--color-space-950: 0 0 0;

		--color-gray-50: 232 255 232;
		--color-gray-100: 200 245 200;
		--color-gray-200: 159 224 159;
		--color-gray-300: 122 204 122;
		--color-gray-400: 79 168 79;
		--color-gray-500: 74 158 74;
		--color-gray-600: 58 138 58;
		--color-gray-700: 46 112 46;
		--color-gray-800: 31 79 31;
		--color-gray-900: 15 36 15;
		--color-gray-950: 5 16 5;

		--color-white: 140 255 163;
	}

	html.hacker body {
		font-family: ui-monospace, Consolas, monospace;
	}

	/* Light text vanishes on bright green fills, so text-white goes black inside them. */
	html.hacker
		:is(
			[class~='bg-primary-500'],
			[class~='bg-primary-600'],
			[class~='bg-primary-700'],
			[class~='dark:bg-primary-500'],
			[class~='dark:bg-primary-600'],
			[class~='dark:bg-primary-700'],
			[class~='bg-green-500'],
			[class~='dark:bg-green-500'],
			[class~='dark:bg-green-600']
		),
	html.hacker
		:is(
			[class~='hover:bg-primary-600'],
			[class~='dark:hover:bg-primary-600'],
			[class~='dark:hover:bg-primary-700'],
			[class~='dark:hover:bg-green-600']
		):hover {
		--color-white: 0 0 0;
	}

