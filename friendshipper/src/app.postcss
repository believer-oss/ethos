		--color-gray-700: 102 92 84;
		--color-gray-800: 80 73 69;
		--color-gray-900: 60 56 54;
		--color-gray-950: 40 40 40;

		--color-white: 235 219 178;
	}

	/* Gruvbox aqua instead of orange for buttons and checked inputs (toggles style the span after their input). */
	html.gruvbox
		:is(
			button,
			[role='button'],
			input[type='checkbox'],
			input[type='radio'],
			input[type='checkbox'] + span
		) {
		--color-primary-600: 66 123 88;
		--color-primary-700: 53 99 71;
		--color-primary-800: 42 79 59;
	}

